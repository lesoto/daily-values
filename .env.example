# Never commit real values. Set these in Vercel's project environment settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Exact production origin, without a trailing slash.
APP_URL=https://YOUR-PROJECT.vercel.app
# Optional comma-separated email allowlist. Empty allows any verified Google account.
ALLOWED_EMAILS=
